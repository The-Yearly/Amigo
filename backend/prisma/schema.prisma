generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String           @unique
  password        String
  bio             String?          @default("")
  department      String?
  year            String?
  profileImage    String?
  rating          Float            @default(0)
  createdAt       DateTime         @default(now())
  isAdmin         Boolean          @default(false)
  admin           Admin?
  isEmailVerified Boolean          @default(false)
  ban             Boolean?           @default(false)
  services        Service[]
  requestsMade    ServiceRequest[] @relation("Requester")
  requestsRecv    ServiceRequest[] @relation("Provider")
  messagesSent    Message[]        @relation("Sender")
  messagesRecv    Message[]        @relation("Receiver")
  FlagRecord      FlagRecord[]
}

model Admin {
  id           String  @id @map("_id") @db.ObjectId
  isSuperAdmin Boolean @default(false)
  canAdd       Boolean @default(false)
  canKick      Boolean @default(false)
  canOverride  Boolean @default(false)
  user         User    @relation(fields: [id], references: [id], onDelete: Cascade)
}

enum Flag {
  ERRAND
  USER
}

enum Stats {
  PENDING
  UNDER_REVIEW
  COMPLETED
}

model FlagRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        Flag
  time        DateTime @default(now())
  status      Stats    @default(PENDING)
  serviceId   String?  @db.ObjectId
  reason      String   @default("")
  adminreason String   @default("")
  service     Service? @relation(fields: [serviceId], references: [id])
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])
  logs        Log[]
}

model Log {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  fid        String @db.ObjectId
  resolution String

  flag FlagRecord @relation(fields: [fid], references: [id])
}

model Service {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  category      String?
  price         Float
  image         String?
  location      String?
  estimatedTime String?
  createdAt     DateTime @default(now())
  hide          Boolean? @default(false)
  creatorId     String   @db.ObjectId
  creator       User     @relation(fields: [creatorId], references: [id])

  requests   ServiceRequest[]
  FlagRecord FlagRecord[]
}

model ServiceRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  status    String // Pending, Accepted, InProgress, Completed
  createdAt DateTime @default(now())

  serviceId String  @db.ObjectId
  service   Service @relation(fields: [serviceId], references: [id])

  requesterId String @db.ObjectId
  requester   User   @relation("Requester", fields: [requesterId], references: [id])

  providerId String @db.ObjectId
  provider   User   @relation("Provider", fields: [providerId], references: [id])

  messages Message[]
  review   Review?
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)

  serviceRequestId String         @db.ObjectId
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  senderId String @db.ObjectId
  sender   User   @relation("Sender", fields: [senderId], references: [id])

  receiverId String @db.ObjectId
  receiver   User   @relation("Receiver", fields: [receiverId], references: [id])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Float
  comment   String?
  createdAt DateTime @default(now())

  serviceRequestId String         @unique @db.ObjectId
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  reviewerId String @db.ObjectId
  providerId String @db.ObjectId
}

model AuditLog {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  action      String
  category    String
  description String
  reason      String?
  type        String
  targetId    String?
  color       String
  iconName    String
  details     Json?

  performedById  String? @db.ObjectId
  affectedUserId String? @db.ObjectId

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
